# Environment Variables for Pricey Backend

PROJECT_NAME="Pricey API"
DATABASE_URL="sqlite:///./pricey.db"

# Periodic Check Interval (in minutes)
PRICE_CHECK_INTERVAL_MINUTES=60

# Default Price Drop Alert Threshold (%)
DEFAULT_PRICE_DROP_THRESHOLD=5.0

# SMTP / Email Configuration (Optional for initial local dev)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
EMAILS_FROM="noreply@pricey.local"

# Security
SECRET_KEY="replace-this-with-a-random-secret-key-in-production"
